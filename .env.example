# Entorno de la aplicacion: use "production" en Easypanel.
APP_ENV=development

# Puerto HTTP de la API y ruta del Angular compilado.
PORT=8080
CLIENT_DIR=ClientApp

# Conexion MySQL. Reemplace host, usuario y clave por los datos reales.
# En Easypanel, el host debe ser el nombre interno del servicio MySQL.
DATABASE_DSN=usuario_aridos:CAMBIAR_CLAVE_MYSQL@tcp(mysql:3306)/gestion_aridos?charset=utf8mb4&parseTime=true&loc=UTC

# Credenciales vigentes para acceder como administrador. La aplicacion las
# valida desde el entorno; no crea ni guarda este usuario en MySQL.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA

# Secreto usado para proteger la autenticacion. Genere al menos 32 bytes
# aleatorios y no lo publique en Git.
APP_AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES

# URL publica sin barra final. En local puede dejar http://localhost:8080.
APP_BASE_URL=http://localhost:8080

# Duracion de la sesion: ejemplos 8h, 12h o 24h.
SESSION_DURATION=12h
